// Task 6: Student Record System - Iterate Over Records

let students = [
    { id: 1, name: "Axilia Jennifer B", marks: 92, age: 20 },
    { id: 2, name: "Rahul", marks: 85, age: 21 },
    { id: 3, name: "Priya", marks: 78, age: 19 },
    { id: 4, name: "David", marks: 88, age: 22 }
];

for (let i = 0; i < students.length; i++) {
    console.log("Student ID:", students[i].id);
    console.log("Name:", students[i].name);
    console.log("Marks:", students[i].marks);
    console.log("Age:", students[i].age);
    console.log("---------------------------");
}
